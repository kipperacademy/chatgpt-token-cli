{
  "name": "chatgpt-token-cli",
  "version": "1.0.0",
  "description": "Terminal tool that signs in with ChatGPT (dynamic client PKCE flow) and prints the Bearer access token",
  "type": "module",
  "bin": {
    "chatgpt-token": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "test:agent": "node --env-file-if-exists=.env test-agent-sdk.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@openai/agents": "^0.21.0",
    "@types/node": "^24.0.0",
    "openai": "^7.45.1",
    "typescript": "^5.6.0",
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
